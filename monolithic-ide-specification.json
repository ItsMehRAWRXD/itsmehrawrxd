{
  "project": {
    "name": "RawrZ Monolithic IDE",
    "version": "1.0.0",
    "description": "Complete monolithic IDE with EON compiler, debugger, and all tools integrated",
    "target": "x86-64 assembly",
    "architecture": "monolithic"
  },
  
  "requirements": {
    "core_features": [
      "EON Language Compiler",
      "Interactive Debugger",
      "Code Editor with Syntax Highlighting",
      "Project Management System",
      "Build System Integration",
      "Error Detection and Reporting",
      "Code Completion Engine",
      "Refactoring Tools",
      "Performance Profiler",
      "Memory Analyzer"
    ],
    
    "compiler_features": [
      "Lexical Analysis (Tokenization)",
      "Syntax Analysis (Parsing)",
      "Semantic Analysis",
      "Intermediate Representation (IR)",
      "Code Generation (x86-64 Assembly)",
      "Optimization Passes",
      "Error Recovery",
      "Incremental Compilation",
      "Live Analysis",
      "Cross-Platform Support"
    ],
    
    "ide_features": [
      "Multi-file Project Support",
      "Real-time Syntax Highlighting",
      "Intelligent Code Completion",
      "Error Squiggles and Diagnostics",
      "Go-to-Definition",
      "Find References",
      "Rename Symbol",
      "Code Formatting",
      "Bracket Matching",
      "Code Folding",
      "Search and Replace",
      "File Explorer",
      "Output Window",
      "Debug Console"
    ],
    
    "debugger_features": [
      "Breakpoint Management",
      "Step-by-step Execution",
      "Variable Inspection",
      "Call Stack View",
      "Memory View",
      "Register View",
      "Disassembly View",
      "Watch Expressions",
      "Conditional Breakpoints",
      "Exception Handling"
    ]
  },
  
  "architecture": {
    "design_pattern": "monolithic",
    "entry_point": "main",
    "memory_layout": {
      "code_section": "0x400000",
      "data_section": "0x600000",
      "heap_section": "0x800000",
      "stack_section": "0x7fffffff"
    },
    
    "modules": [
      {
        "name": "compiler_core",
        "description": "EON language compiler with all phases",
        "size_estimate": "15000 lines",
        "dependencies": ["lexer", "parser", "semantic", "codegen"]
      },
      {
        "name": "ide_interface",
        "description": "User interface and interaction system",
        "size_estimate": "12000 lines",
        "dependencies": ["editor", "project_manager", "ui_components"]
      },
      {
        "name": "debugger_engine",
        "description": "Debugging and analysis engine",
        "size_estimate": "8000 lines",
        "dependencies": ["breakpoint_manager", "execution_control", "inspection"]
      },
      {
        "name": "build_system",
        "description": "Project building and management",
        "size_estimate": "5000 lines",
        "dependencies": ["file_system", "dependency_resolver", "linker"]
      },
      {
        "name": "utility_library",
        "description": "Common utilities and helpers",
        "size_estimate": "3000 lines",
        "dependencies": ["string_utils", "file_utils", "memory_utils"]
      }
    ]
  },
  
  "generation_strategy": {
    "approach": "template_driven",
    "use_existing_templates": true,
    "leverage_ai_generation": true,
    "automated_assembly": true,
    
    "templates": [
      "eon_compiler_template",
      "ide_interface_template", 
      "debugger_template",
      "build_system_template",
      "utility_template"
    ],
    
    "ai_prompts": [
      "Generate complete EON compiler in x86-64 assembly",
      "Create monolithic IDE interface system",
      "Implement comprehensive debugger engine",
      "Build integrated project management system",
      "Generate utility library with all helpers"
    ]
  },
  
  "output_specification": {
    "target_file": "monolithic_ide.asm",
    "estimated_size": "50000+ lines",
    "compilation_target": "executable",
    "entry_point": "_start",
    "calling_convention": "System V ABI",
    
    "sections": [
      ".text (code)",
      ".data (initialized data)", 
      ".bss (uninitialized data)",
      ".rodata (read-only data)"
    ]
  },
  
  "integration_points": [
    {
      "component": "EON Compiler",
      "interface": "compile_eon_source",
      "input": "EON source code",
      "output": "x86-64 assembly"
    },
    {
      "component": "IDE Interface", 
      "interface": "user_interaction",
      "input": "keyboard/mouse events",
      "output": "UI updates"
    },
    {
      "component": "Debugger",
      "interface": "execution_control",
      "input": "debug commands",
      "output": "execution state"
    },
    {
      "component": "Build System",
      "interface": "project_build",
      "input": "project files",
      "output": "executable binary"
    }
  ],
  
  "quality_requirements": {
    "performance": "sub-second compilation for typical projects",
    "memory_usage": "efficient memory management",
    "reliability": "robust error handling",
    "maintainability": "well-structured modular code",
    "extensibility": "easy to add new features"
  }
}
