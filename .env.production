# Production Environment Variables
# Copy this to .env for local testing or set in DigitalOcean dashboard

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Memory optimization
NODE_OPTIONS=--max-old-space-size=256

# Security (generate your own tokens)
AUTH_TOKEN=your_secure_auth_token_here
JWT_SECRET=your_jwt_secret_here

# Rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=1000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Health check
HEALTH_CHECK_PATH=/health

# Optional: Database connection (if using external DB)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional: Redis cache (if using external cache)
# REDIS_URL=redis://host:6379