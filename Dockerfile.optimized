# Optimized Dockerfile for DigitalOcean App Platform
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install only essential system dependencies
RUN apk update && apk add --no-cache \
    curl \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S rawrz -u 1001

# Copy optimized package.json with minimal dependencies
COPY package.optimized.json package.json

# Install dependencies with optimization flags
RUN npm ci --only=production --no-audit --no-fund

# Copy application files
COPY --chown=rawrz:nodejs . .

# Create necessary directories with proper permissions
RUN mkdir -p logs temp uploads && \
    chown -R rawrz:nodejs /app

# Switch to non-root user
USER rawrz

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Set NODE_ENV and memory limit
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=512"

# Start the application
CMD ["node", "server.optimized.js"]