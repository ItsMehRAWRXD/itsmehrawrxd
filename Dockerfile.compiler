FROM ubuntu:22.04

# Install build essentials and compilers
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    clang \
    clang++ \
    make \
    cmake \
    git \
    wget \
    curl \
    upx \
    mingw-w64 \
    wine \
    && rm -rf /var/lib/apt/lists/*

# Install additional tools
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /compile

# Copy compilation scripts
COPY compile-scripts/ /compile/scripts/
RUN chmod +x /compile/scripts/*.sh

# Set environment variables
ENV CC=gcc
ENV CXX=g++
ENV PATH="/compile/scripts:${PATH}"

# Default command
CMD ["/bin/bash"]