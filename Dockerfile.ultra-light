# Ultra-lightweight for 1GB RAM deployment
FROM node:18-alpine

# Minimal install
RUN apk add --no-cache git

WORKDIR /app

# Copy minimal files
COPY package-minimal.json package.json
COPY server-minimal.js server.js
COPY rawrz-standalone.js ./

# Install minimal deps
RUN npm install --production --no-optional

# Create dirs
RUN mkdir -p uploads downloads temp

# Expose port
EXPOSE 8080

# Start
CMD ["node", "server.js"]