# RawrZ Security Platform - Deployment Configuration
# This file helps deployment platforms understand the correct startup method

# Primary startup command (lowercase npm)
START_COMMAND=npm start

# Alternative startup commands
ALTERNATIVE_COMMANDS=node api-server-no-cli.js,./start.sh

# Required environment variables
REQUIRED_ENV=NODE_ENV,PORT

# Default environment variables
DEFAULT_ENV=NODE_ENV=production,PORT=3000

# Health check endpoint
HEALTH_CHECK_URL=http://localhost:3000/api/health

# Application type
APP_TYPE=nodejs

# Build requirements
BUILD_REQUIREMENTS=npm install --legacy-peer-deps