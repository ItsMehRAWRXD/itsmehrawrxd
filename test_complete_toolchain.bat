echo Step 6: Testing Complete Pipeline...
echo Testing complete EON to EXE pipeline...
python -c "
import sys
sys.path.append('.')
from eon_to_machine_code_compiler import compileEonToMachineCode
from custom_assembler import assembleSource
from custom_linker import linkObjects
from compiler_pattern_generator import DynamicCompilerGenerator

# Complete pipeline test
print('Complete Pipeline Test')
print('======================')

# 1. EON source
eon_source = '''
module PipelineTest

function main() -> int {
    var message: string = 'Hello from complete pipeline!'
    println(message)
    return 42
}
'''

print('1. EON Source:')
print(eon_source)
print()

# 2. Compile to machine code
print('2. Compiling to machine code...')
machine_code = compileEonToMachineCode(eon_source, 'x86_64')
print(f'   Generated {len(machine_code)} bytes')
print()

# 3. Convert to assembly
print('3. Converting to assembly...')
assembly_source = f'''
; Generated by complete pipeline
.section .text
.global _start

_start:
    ; Entry point
    mov rax, 1      ; sys_write
    mov rdi, 1      ; stdout
    mov rsi, message
    mov rdx, 30
    syscall
    
    ; Exit
    mov rax, 60
    mov rdi, 42
    syscall

.section .data
message: db 'Hello from complete pipeline!', 0
'''

with open('pipeline_test.asm', 'w') as f:
    f.write(assembly_source)
print('   Assembly source created')
print()

# 4. Assemble
print('4. Assembling...')
success = assembleSource('pipeline_test.asm', 'pipeline_test.o', 'x86_64')
if success:
    print('   Assembly successful')
else:
    print('   Assembly failed')
    exit(1)
print()

# 5. Link
print('5. Linking...')
success = linkObjects(['pipeline_test.o'], 'pipeline_test.exe', 'x86_64')
if success:
    print('   Linking successful')
else:
    print('   Linking failed')
    exit(1)
print()

# 6. Pattern generation
print('6. Generating with pattern...')
generator = DynamicCompilerGenerator()
result = generator.generate_compiler_with_pattern(
    eon_source, 
    'pipeline_pattern.exe', 
    'stealth'
)

if result['success']:
    print('    Pattern generation successful')
    print(f'    Pattern: {result[\"pattern\"][\"compiler_name\"]}')
else:
    print('   Pattern generation failed')
print()

print('Complete pipeline test successful!')
print('Generated executables:')
print('   - pipeline_test.exe')
print('   - pipeline_pattern.exe')
"

