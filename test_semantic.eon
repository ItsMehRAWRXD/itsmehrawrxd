// Test file for Eon semantic analyzer
// This file demonstrates various semantic checks

let x = 42;
let y = x + 10;
let z = y * 2;

// Test type checking
let ptr = &x;
let value = *ptr;

// Test function definition
func add(a, b) {
    ret a + b;
}

// Test function call
let result = add(5, 3);

// Test conditional
if x > 10 {
    let temp = x - 10;
}

