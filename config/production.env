# RawrZ Security Platform - Production Environment Configuration
# DO NOT commit this file with real secrets - use Docker secrets or environment variables

# Application Configuration
NODE_ENV=production
PORT=3000
API_PORT=3000
LOG_LEVEL=warn
DEBUG=false

# Server Configuration
HOST=0.0.0.0
MAX_CONNECTIONS=1000
KEEP_ALIVE_TIMEOUT=65000
HEADERS_TIMEOUT=66000

# Database Configuration
DB_HOST=rawrz-db
DB_PORT=5432
DB_NAME=rawrz_security
DB_USER=rawrz_user
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000
DB_SSL=false

# Redis Configuration
REDIS_HOST=rawrz-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_IN_PRODUCTION
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=10000
REDIS_LAZYCONNECT=true

# Security Configuration
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=24h
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION
SESSION_TIMEOUT=1800000
ENCRYPTION_KEY=CHANGE_THIS_TO_32_BYTE_HEX_IN_PRODUCTION
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=https://your-domain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_DIR=/app/uploads
DOWNLOAD_DIR=/app/downloads
TEMP_DIR=/app/temp
ALLOWED_EXTENSIONS=.exe,.dll,.bin,.pdf,.txt,.zip,.rar

# Directory Configuration
LOGS_DIR=/app/logs
DATA_DIR=/app/data
KEYS_DIR=/app/keys
STUBS_DIR=/app/stubs
PAYLOADS_DIR=/app/payloads
BOTS_DIR=/app/bots
CVE_DIR=/app/cve
ENGINES_DIR=/app/engines
BACKUPS_DIR=/app/backups

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# Monitoring and Metrics
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# Application Features
ENABLE_FILE_PROCESSING=true
ENABLE_BOT_MANAGEMENT=true
ENABLE_CVE_SCANNING=true
ENABLE_ENCRYPTION=true
ENABLE_PAYLOAD_GENERATION=true

# Bot Management
MAX_BOTS=50
BOT_TIMEOUT=300000
BOT_HEARTBEAT_INTERVAL=30000
BOT_CLEANUP_INTERVAL=600000

# File Processing
MAX_WORKERS=4
WORKER_TIMEOUT=300000
PROCESSING_QUEUE_SIZE=100
ENABLE_VIRUS_SCAN=false

# CVE Configuration
CVE_UPDATE_INTERVAL=86400000
CVE_API_KEY=
CVE_DATABASE_PATH=/app/data/cve.db

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=admin@your-domain.com

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true

# Performance Tuning
NODE_OPTIONS=--max-old-space-size=2048
UV_THREADPOOL_SIZE=16
CLUSTER_MODE=false
CLUSTER_WORKERS=0

# Development/Debug (disabled in production)
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
VERBOSE_LOGGING=false
STACK_TRACE_LIMIT=0